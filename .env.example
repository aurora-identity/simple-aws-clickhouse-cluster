# Copy this file to .env. Only the aws-* targets read it.

# The region to build in. The stack picks the first three availability zones it finds there.
AWS_REGION=eu-central-1

# Name for the CloudFormation stacks and the EKS cluster. Change it if it clashes with
# something you already have.
STACK_NAME=clickhouse

# Optional. Address ranges that may reach the Kubernetes API from the internet, comma
# separated. Leave unset to allow only the address you run make aws-plan from.
# API_ALLOWED_CIDRS=203.0.113.0/24,198.51.100.7/32
